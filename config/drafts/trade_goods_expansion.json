    {
      "name": "ships",
      "change": "replace input 'fiber': 0.22 with 'cordage': 0.20; move the matching marketInputCapabilityFloor entry from fiber 0.20 to cordage 0.18",
      "why": "Completes fiber -> cordage -> ships as a real 3-step chain instead of a shipyard spinning its own rope. Replacing rather than adding keeps the gate count at three; inputAccess is a MIN over inputs, so adding cordage alongside fiber would double-gate shipbuilding.",
      "proposedInputs": {"timber": 0.55, "cordage": 0.20, "resin": 0.18},
      "proposedMarketInputCapabilityFloor": {"timber": 0.35, "cordage": 0.18, "resin": 0.18}
    },
    {
      "name": "soap",
      "change": "add 'tallow': 0.07 and 'plant_oil': 0.07 to inputs; do NOT add capability floors for them",
      "why": "Soap is lye plus a fat; today it takes salt + livestock + herbs, i.e. the fat is implied by livestock. Small need values keep the MIN gate soft (a polity with any tallow or oil clears it, and 0.28*tradeAccess covers importers) while making the olive/oilseed regions genuinely better at soap. NOTE: the schema has no substitutable-input operator, so 'olive_oil OR plant_oil OR tallow' cannot be expressed; olive_oil is deliberately left out of soap so Mediterranean polities are not required to have all three.",
      "proposedInputs": {"salt": 0.14, "livestock": 0.08, "tallow": 0.07, "plant_oil": 0.07, "herbs": 0.03}
    },
