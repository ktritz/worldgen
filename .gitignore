# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.json
*.obj
*.png

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Build artifacts
main
server/server
server/server.pid
cmd/*/generate_planet
cmd/*/evaluate_plates
cmd/*/pipeline-cli
cmd/*/pipeline-cli-*
cmd/*/validate_tectonics
cmd/*/worldgen-cli

# Log files
*.log
server/server_debug.log

# Windows metadata
*:Zone.Identifier

# External reference code
redblobgames-planet/

# Handoff files
HANDOFF*.md

# Deprecated code (historical reference only)
deprecated/

# Compiled binaries (root level)
analyze_biomes
compare_noise
generate_planet
test_hotspot_geometry
test_ocean_currents
test_temperature
test_wind

# Output directories
output/
cli_output/
mesh_cache/
evaluation_output/
output_from_server/
diff_images
